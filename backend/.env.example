# Copie este arquivo para .env e preencha com seus dados. Não envie o .env ao GitHub.
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=academia_facil

# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=preencha_com_uma_chave_gerada_antes_de_iniciar
JWT_EXPIRES_IN=2h
